{
  "name": "gridstream-agent",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:frontend": "pnpm --filter @gridstream/web dev",
    "dev:backend": "pnpm --filter @gridstream/api dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @gridstream/api db:generate",
    "db:migrate": "pnpm --filter @gridstream/api db:migrate",
    "db:seed": "pnpm --filter @gridstream/api db:seed",
    "db:seed:history": "pnpm --filter @gridstream/api db:seed:history"
  },
  "keywords": [],
  "author": "Ahmed Bashir",
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.30.3",
  "devDependencies": {
    "turbo": "^2.10.4"
  }
}