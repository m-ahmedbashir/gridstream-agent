{
  "name": "maintain-agent",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:frontend": "pnpm --filter @maintain/frontend dev",
    "dev:backend": "pnpm --filter @maintain/backend dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @maintain/backend db:generate",
    "db:migrate": "pnpm --filter @maintain/backend db:migrate"
  },
