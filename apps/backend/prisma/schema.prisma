// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(cuid())
  clerkId           String   @unique
  extractionMode    String   @default("MANUAL_REVIEW") // "AUTO_APPROVE" | "MANUAL_REVIEW"
  planApprovalMode  String   @default("MANUAL_REVIEW") // "AUTO_APPROVE" | "MANUAL_REVIEW"
  modelKey          String   @default("groq:llama-4-scout") // key into MODEL_REGISTRY (apps/backend/src/modules/extraction/model-registry.ts)
  encryptedApiKey   String?  // AES-256-GCM ciphertext (see common/crypto/) — NEVER the plaintext key. Null = use the app's shared key.
  processingMode    String   @default("vision") // "vision" | "local-ocr" — how images/scanned PDFs get read
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  documents         Document[]
  machineProfiles   MachineProfile[]
}

model Document {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Which document-type registry entry (see extraction/document-type-registry.ts) this was extracted with.
  documentType     String   // "invoice" | "receipt" | "resume"

  // The type-specific extracted fields (shape matches that type's Zod schema in @maintain/shared).
  data             Json

  // AI confidence — stored alongside the extracted data
  fieldConfidence  Json?    // { <field>: 0.95, ... }
  avgConfidence    Float?

  // Status
  status           String   @default("APPROVED") // APPROVED | REJECTED | PENDING
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([documentType])
}

model ExtractionLog {
  id               String   @id @default(cuid())

  // What came in
  sourceType       String   // PDF | IMAGE | TEXT | CSV | JSON
  documentType     String?  // "invoice" | "receipt" | "resume" — null for old rows predating this field
  originalFileName String?
  fileSizeBytes    Int?

  // What the pipeline measured
  piiDetected      Boolean  @default(false)
  imagePiiDetected Boolean  @default(false) // PII visible in image pixels — text masking can't reach this
  ocrUsed          Boolean  @default(false) // true when local Tesseract OCR ran instead of a vision model
  processingTimeMs Int

  // AI confidence for this extraction
  avgConfidence    Float?

  // Outcome
  success          Boolean  @default(true)
  errorMessage     String?
  invoiceId        String?  // set when the user saves/approves the invoice

  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([sourceType])
  @@index([success])
}

model MachineProfile {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  machineId           String   @unique
  machineType         String
  manufacturer        String
  yearInstalled       Int
  runtimeHours        Int
  lastServiceDate     DateTime?
  observedIssues      String[]
  energyConsumptionKwh Int?
  criticality         String
  location            String?
  extractedAt         DateTime @default(now())
  rawText             String? // stored original text for audit
  plans               Plan[]

  @@index([userId])
  @@index([machineType])
}

model Measure {
  id                    String   @id @default(uuid())
  category              String
  title                 String
  titleDe               String
  description           String
  applicableMachineTypes String[]
  minRuntimeHours       Int?
  typicalInvestment     Int
  typicalAnnualSavings  Int
  paybackMonths         Int
  co2ReductionKg        Int?
  tasks                 Json
}

model Plan {
  id                  String   @id @default(uuid())
  machineProfileId    String
  machineProfile      MachineProfile @relation(fields: [machineProfileId], references: [id], onDelete: Cascade)
  status              String   @default("draft")
  confidence          Float
  totalInvestment     Int
  totalAnnualSavings  Int
  paybackMonths       Int
  totalDowntimeHours  Int?
  totalCo2ReductionKg Int?
  measures            Json
  executiveSummary    String
  executiveSummaryEn  String?
  generatedAt         DateTime @default(now())
  approvedAt          DateTime?
  approvedBy          String?

  @@index([machineProfileId])
  @@index([status])
}
