# Server Port
PORT=3001

# OpenRouter API Key (Required for the default free vision model)
# Get your free key from: https://openrouter.ai (no credit card needed)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Groq API Key (Optional — only needed if you switch to a Groq model in Settings)
# Get your free key from: https://console.groq.com (no credit card needed)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key (Optional — only needed if you switch to openai:gpt-4o)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (Optional — only needed if you switch to anthropic:claude-3-5-sonnet)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Electricity Maps API Token (Optional — powers carbon-aware plan scheduling)
# Get your free key from: https://www.electricitymaps.com (free personal tier, no card needed)
# Without this, plan generation works exactly as before — the carbon context line is just omitted.
ELECTRICITY_MAPS_TOKEN=your_electricity_maps_token_here

# Database URL (PostgreSQL)
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Encryption key for user-supplied (BYOK) provider API keys — AES-256-GCM, so this
# must decode to exactly 32 bytes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this key makes any previously-saved user API keys undecryptable — treat
# it like any other production secret, never commit a real value.
BYOK_ENCRYPTION_KEY=replace_with_a_32_byte_base64_key

